# Environment Configuration for TripoSR API

# Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Queue & Processing
MAX_QUEUE_SIZE=10
REQUEST_TIMEOUT=60

# Rate Limiting (requests/minute per IP)
RATE_LIMIT=10/minute

# Job Management
JOB_TTL_SECONDS=3600

# File Upload
MAX_FILE_SIZE_MB=10

# GPU Management
GPU_MEMORY_THRESHOLD=0.9

# Monitoring
ENABLE_METRICS=true

# Phase 2: Distributed Queue (Optional - uncomment when needed)
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Phase 2: Object Storage (Optional)
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=triposr-results
